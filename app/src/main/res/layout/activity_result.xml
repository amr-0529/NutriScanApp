<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    tools:context=".ResultActivity">

    <TextView
        android:id="@+id/textViewResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:text="Scan Results"
        android:textColor="#333333"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        />

    <TextView
        android:id="@+id/textViewFoodName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewResultTitle"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="40dp"
        android:text="Food Name: Unknown"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        />

    <View
        android:id="@+id/healthStatusIndicator"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/textViewFoodName"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="20dp"
        android:background="#CCCCCC"
        />

    <TextView
        android:id="@+id/textViewHealthStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/healthStatusIndicator"
        android:layout_alignBottom="@+id/healthStatusIndicator"
        android:layout_centerHorizontal="true"
        android:gravity="center_vertical"
        android:text="Status: Loading..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/textViewSugar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/healthStatusIndicator"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="30dp"
        android:text="Sugar: --"
        android:textColor="#333333"
        android:textSize="18sp"
        />

    <TextView
        android:id="@+id/textViewSalt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewSugar"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        android:text="Salt: --"
        android:textColor="#333333"
        android:textSize="18sp"
        />

    <TextView
        android:id="@+id/textViewFat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewSalt"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        android:text="Fat: --"
        android:textColor="#333333"
        android:textSize="18sp"
        />

    <TextView
        android:id="@+id/textViewLocationDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewFat"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="30dp"
        android:text="Scanned: --/--/---- at Unknown Location"
        android:textColor="#666666"
        android:textSize="14sp"
        android:gravity="center_horizontal"
        android:textStyle="italic"
        />

    <TextView
        android:id="@+id/textViewTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewLocationDate"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        android:text="Tips: Looking good!"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="italic"
        android:gravity="center_horizontal"
        />

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/rounded_button_background"
        android:text="Back to Home"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:foreground="?attr/selectableItemBackground"
        />

</RelativeLayout>