<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    tools:context=".SettingsActivity">

    <!-- Title for the Settings screen -->
    <TextView
        android:id="@+id/textViewSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:text="Settings"
        android:textColor="#333333"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        />

    <!-- Placeholder for a setting option -->
    <TextView
        android:id="@+id/textViewNotificationSetting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewSettingsTitle"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="50dp"
        android:text="Enable Notifications (Coming Soon!)"
        android:textColor="#555555"
        android:textSize="18sp"
        android:padding="15dp"
        android:background="@drawable/rounded_edittext_background"
        android:drawableEnd="@android:drawable/checkbox_off_background"
        />

    <!-- Button to go back -->
    <Button
        android:id="@+id/buttonBackSettings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/rounded_button_background"
        android:text="Back"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:foreground="?attr/selectableItemBackground"
        />

</RelativeLayout>